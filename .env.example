# CORE
DATABASE_URL=postgresql+asyncpg://user:password@ep-xxx.neon.tech/caca?ssl=require
REDIS_URL=rediss://default:password@xxx.upstash.io:6379
JWT_SECRET=ganti-dengan-random-string-panjang-minimal-32-karakter
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
ENV=development
FRONTEND_URL=http://localhost:3000
LOG_LEVEL=INFO

# Untuk dev lokal pakai docker-compose, DATABASE_URL & REDIS_URL di atas
# otomatis di-override lewat environment di docker-compose.yml.


# ADMIN DASHBOARD

ADMIN_EMAIL=admin@caca-auth.dev
ADMIN_PASSWORD_HASH=
# generate hash: python scripts/create_admin.py


# EMAIL PROVIDER (hybrid, isi salah satu atau lebih — urutan = urutan fallback)

RESEND_API_KEY=
BREVO_API_KEY=
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
SMTP_GMAIL_USER=
SMTP_GMAIL_PASS=
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
SENDGRID_API_KEY=
FIREBASE_API_KEY=
NTFY_URL=
GOTIFY_URL=
GOTIFY_TOKEN=
APPRISE_URL=


# SMS/WHATSAPP PROVIDER (hybrid, isi salah satu atau lebih)

ZENZIVA_API_KEY=
ZENZIVA_USER_KEY=
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
VONAGE_API_KEY=
VONAGE_API_SECRET=
TERMII_API_KEY=
FONNTE_TOKEN=
WABLAS_TOKEN=
MESSAGEBIRD_API_KEY=
TELEGRAM_BOT_TOKEN=
META_WA_TOKEN=
META_WA_PHONE_ID=
TEXTBEE_API_KEY=


# SUPABASE (dipakai untuk email/auth fallback DAN storage)

SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_STORAGE_BUCKET=avatars


# STORAGE PROVIDER (hybrid, urutan = urutan fallback; local selalu jadi fallback terakhir)

IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_URL_ENDPOINT=
IMGBB_API_KEY=
GITHUB_STORAGE_TOKEN=
GITHUB_STORAGE_REPO=
LOCAL_STORAGE_PATH=./static/uploads


# GEOIP (hybrid, IP address -> lokasi)

IPAPI_URL=https://ipapi.co
IPGEOLOCATION_API_KEY=

# Nominatim (OpenStreetMap) TIDAK butuh API key, dipakai untuk geocoding
# alamat <-> koordinat via endpoint /geocoding/*, terpisah dari GeoIP di atas.


# OAUTH / SOCIAL LOGIN

OAUTH_REDIRECT_BASE=http://localhost:8000

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# Apple butuh private key .p8 (bukan client_secret string biasa)
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=./secrets/apple_auth_key.p8

# Instagram: HANYA mendukung akun Business/Creator sejak Basic Display API
# di-deprecate Meta Des 2024. Akun personal tidak bisa login lewat jalur ini.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=


# SIEM / LOG EXPORT

DATADOG_API_KEY=
AXIOM_API_TOKEN=
AXIOM_DATASET=
BETTERSTACK_SOURCE_TOKEN=